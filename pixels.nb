              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "yvals", "]"}]}], "}"}]}], "]"}]}], 
          ";"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Ec", " ", "=", " ", 
