            RowBox[{"mid", "=", 
             RowBox[{
              RowBox[{"bin", "*", 
               RowBox[{"Floor", "[", 
                RowBox[{"w", "/", "bin"}], "]"}]}], "+", 
              RowBox[{"bin", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"start", "=", 
             RowBox[{"mid", "-", 
              RowBox[{"bin", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"end", "=", 
             RowBox[{"mid", "+", 
              RowBox[{"bin", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"slope", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"phi", "[", "end", "]"}], "-", 
                RowBox[{"phi", "[", "start", "]"}]}], ")"}], "/", "bin"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"phi", "[", "mid", "]"}], "+", 
             RowBox[{"slopy", "*", "slope", "*", 
              RowBox[{"(", 
               RowBox[{"w", "-", "mid"}], ")"}]}]}]}]}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xmin", "=", 
         RowBox[{"w0", "-", "0.5"}]}], ";", "\[IndentingNewLine]", 
