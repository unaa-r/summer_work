            RowBox[{"2", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"-", 
               SuperscriptBox["x", "2"]}]]}], 
            SqrtBox["\[Pi]"]], "+", "x", "-", 
           RowBox[{"2", " ", "x", " ", 
            RowBox[{"Erfc", "[", "x", "]"}]}]}], ")"}]}], 
        RowBox[{
         RowBox[{"b", " ", "T0", " ", 
          RowBox[{"Erf", "[", "x", "]"}]}], "\[GreaterEqual]", "0"}]},
       {
        RowBox[{
         FractionBox["1", "2"], " ", "b", " ", "T0", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            FractionBox[
             RowBox[{"2", " ", 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{"-", 
                SuperscriptBox["x", "2"]}]]}], 
             SqrtBox["\[Pi]"]]}], "-", 
           RowBox[{"3", " ", "x"}], "+", 
           RowBox[{"2", " ", "x", " ", 
            RowBox[{"Erfc", "[", "x", "]"}]}]}], ")"}]}], 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
