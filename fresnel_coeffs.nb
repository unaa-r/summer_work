Cell["\<\

In order to get the transfer function for a slip of glass (or some other \
material), we first need the index of refraction. I am assuming air to be \
vacuum here, with unit index.\
\>", "Text",
 CellChangeTimes->{{3.9604696173943663`*^9, 
  3.960469678445217*^9}},ExpressionUUID->"79f979e9-bd39-477a-a779-\
2ce366667a8a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"For", " ", "BK7", " ", 
    RowBox[{"Glass", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"c", " ", "=", " ", "0.2998"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"um", "/", "fs"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b1", " ", "=", " ", "1.03961212"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"for", " ", "BK7", " ", "glass"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"b2", " ", "=", " ", "0.231792344"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b3", " ", "=", " ", "1.01046945"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c1", " ", "=", " ", 
     RowBox[{"6.00069867", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"\[Minus]", "3"}], ")"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"um", "^", "2"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"c2", " ", "=", " ", 
     RowBox[{"2.00179144", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"\[Minus]", "2"}], ")"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"c3", " ", "=", " ", 
     RowBox[{"1.03560653", "*", 
      RowBox[{"10", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"n", "[", "w_", "]"}], ":=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b1", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "Pi", "*", 
             RowBox[{"c", "/", "w"}]}], ")"}], "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "Pi", "*", 
             RowBox[{"c", "/", "w"}]}], ")"}], "^", "2"}], "-", "c1"}], 
         ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b2", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "Pi", "*", 
             RowBox[{"c", "/", "w"}]}], ")"}], "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "Pi", "*", 
             RowBox[{"c", "/", "w"}]}], ")"}], "^", "2"}], "-", "c2"}], 
         ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b3", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "Pi", "*", 
             RowBox[{"c", "/", "w"}]}], ")"}], "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "Pi", "*", 
             RowBox[{"c", "/", "w"}]}], ")"}], "^", "2"}], "-", "c3"}], 
         ")"}]}]}], "]"}]}], ";"}]}]}]], "Input",
