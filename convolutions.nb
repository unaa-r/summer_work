Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "convolution", " ", "over", " ", "the", " ", 
    "valid", " ", "domain"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"y", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"InverseErf", "[", "t", "]"}], "^", "2"}], "]"}], " ", 
     RowBox[{"UnitStep", "[", 
      RowBox[{"1", "-", "t"}], "]"}], " ", 
     RowBox[{"UnitStep", "[", 
      RowBox[{"t", "+", "1"}], "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"conv", "[", "x_", "]"}], ":=", 
    RowBox[{"Convolve", "[", 
     RowBox[{
      RowBox[{"y", "[", "t", "]"}], ",", 
      RowBox[{"y", "[", "t", "]"}], ",", "t", ",", "x"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"convSimplified", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"conv", "[", "x", "]"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"Element", "[", 
        RowBox[{"x", ",", "Reals"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n"}]}]], "Input",
 CellChangeTimes->{{3.961774008229266*^9, 3.9617740085607147`*^9}, {
   3.96177404045614*^9, 3.961774096079234*^9}, {3.961774143522023*^9, 
   3.961774148139513*^9}, {3.9617742668238497`*^9, 3.961774292054442*^9}, 
   3.9617747751393127`*^9, {3.961774996451128*^9, 3.961775013337357*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"7307669a-6ea5-45c0-982d-d77ce7b3f30f"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        RowBox[{"Convolve", "[", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           SuperscriptBox[
            RowBox[{"InverseErf", "[", "t", "]"}], "2"]], ",", 
          SuperscriptBox["\[ExponentialE]", 
           SuperscriptBox[
            RowBox[{"InverseErf", "[", "t", "]"}], "2"]], ",", "t", ",", 
          "x"}], "]"}], 
        RowBox[{
         RowBox[{"-", "1"}], "\[LessEqual]", "t", "\[LessEqual]", "1"}]},
       {"0", 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
      Editable->True,
